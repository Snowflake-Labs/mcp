# Snowflake MCP Server - Environment Variables Example
# Copy this file to .env and fill in your values
# DO NOT commit .env file with real credentials to version control

# ============================================
# REQUIRED: Snowflake Connection Parameters
# ============================================

# Snowflake Account Identifier
# Format: orgname-accountname or accountname.region
# Example: xy12345.us-east-1 or myorg-myaccount
SNOWFLAKE_ACCOUNT=your_account_identifier

# Snowflake Username
SNOWFLAKE_USER=your_username

# ============================================
# AUTHENTICATION METHOD (Choose ONE)
# ============================================

# Option A: Password/PAT Authentication (choose one of these two)
# Use your Snowflake password OR Programmatic Access Token (PAT)
SNOWFLAKE_PASSWORD=your_password_or_pat

# Option B: Key Pair Authentication (use instead of password)
# Paste the entire private key content (including BEGIN/END markers)
# SNOWFLAKE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhki...\n-----END PRIVATE KEY-----

# Optional: Password for encrypted private key file
# SNOWFLAKE_PRIVATE_KEY_FILE_PWD=your_key_password

# Alternative: Path to private key file (instead of pasting content)
# SNOWFLAKE_PRIVATE_KEY_FILE=/path/to/private_key.p8

# ============================================
# OPTIONAL: Additional Connection Parameters
# ============================================

# Snowflake Role (defaults to user's default role if not specified)
# SNOWFLAKE_ROLE=your_role_name

# Snowflake Warehouse (required for query execution)
# SNOWFLAKE_WAREHOUSE=your_warehouse_name

# Snowflake Host (usually auto-detected from account)
# SNOWFLAKE_HOST=your_account.snowflakecomputing.com

# ============================================
# OPTIONAL: MCP Server Configuration
# ============================================

# Custom endpoint path for HTTP transports
# Default: /mcp
# SNOWFLAKE_MCP_ENDPOINT=/snowflake-mcp

# Path to service configuration file
# Default: services/tools_config.yaml
# SERVICE_CONFIG_FILE=/path/to/your/tools_config.yaml

# ============================================
# OPTIONAL: Authentication Method
# ============================================

# Authenticator type (usually not needed)
# Options: snowflake (default), externalbrowser, oauth, etc.
# SNOWFLAKE_AUTHENTICATOR=snowflake

# ============================================
# OPTIONAL: MFA Configuration
# ============================================

# MFA Passcode (if using MFA)
# SNOWFLAKE_PASSCODE=123456

# Whether passcode is embedded in password
# SNOWFLAKE_PASSCODE_IN_PASSWORD=false

# ============================================
# RAILWAY.COM DEPLOYMENT NOTES
# ============================================
# When deploying to Railway.com:
# 1. Set these variables in the Railway dashboard under "Variables" tab
# 2. DO NOT use .env file - Railway manages environment variables
# 3. Minimum required: SNOWFLAKE_ACCOUNT, SNOWFLAKE_USER, and password/key
# 4. Railway automatically provides HTTPS and domain
# 5. See RAILWAY_DEPLOYMENT.md for detailed instructions

# ============================================
# DOCKER DEPLOYMENT NOTES
# ============================================
# When deploying with Docker:
# 1. Copy this file to .env and fill in values
# 2. Docker will automatically load .env file
# 3. Or use docker run -e flags to pass variables
# 4. For docker-compose, variables are passed through compose.yml

# ============================================
# LOCAL DEVELOPMENT NOTES
# ============================================
# For local testing with Claude Desktop or Cursor:
# 1. You can use connection_name instead of individual variables
# 2. Configure connections in ~/.snowflake/connections.toml
# 3. Pass --connection-name flag when starting server
# 4. See README.md for detailed local setup instructions

# ============================================
# SECURITY BEST PRACTICES
# ============================================
# 1. Use Programmatic Access Tokens (PAT) instead of passwords
# 2. Prefer key pair authentication for production
# 3. Use least-privilege roles with minimal permissions
# 4. Rotate credentials regularly
# 5. Never commit .env file with real credentials to Git
# 6. Use different credentials for dev/staging/production
# 7. Monitor Snowflake query history for unusual activity

# ============================================
# TROUBLESHOOTING
# ============================================
# Account Identifier Issues:
#   - If account has underscores, try dash version
#   - Example: acme_test_account → acme-test-account
#
# Authentication Errors:
#   - Verify username/password are correct
#   - For PAT, ensure it's assigned the correct role
#   - For key pair, check private key format and password
#
# Connection Timeout:
#   - Check SNOWFLAKE_ACCOUNT format
#   - Verify network access to Snowflake
#   - Check warehouse is running if specified
